# Copy to .env and fill in. Never commit .env.

# The address people open the app at (no trailing slash)
PUBLIC_URL=http://localhost:3000

# This email can sign up without an invite and becomes the admin
ADMIN_EMAIL=you@example.se

# Optional: "Continue with Google". Leave empty to use email and password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: run published images instead of building locally
# DOCKERHUB_USERNAME=yourname
# TAG=1.0.0

# Optional: use Postgres instead of SQLite (the default, stored in the data volume)
# DATABASE_URL=postgres://house:password@db.example.se:5432/house?sslmode=require
